# Copie este arquivo para .env (o .env real NÃO vai para o Git) e preencha.

# Segredo usado para assinar/validar os tokens de login (mínimo 32 caracteres).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em produção, defina a MESMA variável no painel do servidor de deploy.
JWT_SECRET=

# Banco de dados (Aiven MySQL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

PORT=8080
