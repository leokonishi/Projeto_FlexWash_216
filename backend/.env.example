# Copie este arquivo para .env (o .env real NÃO vai para o Git) e preencha.

# Segredo usado para assinar/validar os tokens de login (mínimo 32 caracteres).
# Gere um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em produção, defina a MESMA variável no painel do servidor de deploy.
JWT_SECRET=

# Banco de dados (Aiven MySQL)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Certificado da Aiven (ca.pem, baixe no painel do serviço MySQL) para validar o servidor do banco.
# Use UMA das duas formas. Sem nenhuma, a conexão funciona mas não valida o certificado (e avisa no log).
#   DB_SSL_CA_PATH=certs/ca.pem   (caminho relativo à pasta backend/; não versione o arquivo se preferir)
#   DB_SSL_CA=                    (conteúdo do certificado; use \n no lugar das quebras de linha)
DB_SSL_CA_PATH=
DB_SSL_CA=

# Máximo de conexões simultâneas com o banco (padrão 10; no plano gratuito da Aiven use 5)
DB_POOL_LIMIT=10

PORT=8080

# Endereço(s) do frontend publicado que podem chamar a API, separados por vírgula
# (ex.: https://flexwash.vercel.app). Vazio = libera qualquer origem (bom no computador).
CORS_ORIGIN=

# Mapa do leva e traz (opcional). Por padrão usa os serviços públicos e gratuitos do
# OpenStreetMap (Nominatim para achar o endereço e OSRM para a rota), sem chave.
# Troque as URLs se um dia usar um servidor próprio.
# MAPA_NOMINATIM_URL=https://nominatim.openstreetmap.org
# MAPA_OSRM_URL=https://router.project-osrm.org
# MAPA_VIACEP_URL=https://viacep.com.br
# MAPA_USER_AGENT=FlexWash/1.0 (contato@seudominio.com.br)
